{
 "name": "docrot-scan-api",
 "version": "1.5.0",
 "description": "Paid link-rot scanning API for public GitHub repositories. Scans Markdown/MDX/reStructuredText/HTML files and reports broken remote http(s) links and images.",
 "docs": "https://github.com/auroraxo/docrot-api/blob/main/docs/API.md",
 "baseUrl": "https://codebyaurora.com/docrot-api/",
 "endpoints": {
  "scan": {
   "method": "POST",
   "path": "/v1/scan",
   "url": "https://codebyaurora.com/docrot-api/v1/scan",
   "requestContentType": "application/json",
   "requestSchema": {
    "type": "object",
    "required": [
     "repository"
    ],
    "properties": {
     "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/<owner>/<repo>(/(tree|blob)/<ref>)?$",
      "description": "Public GitHub HTTPS repository URL"
     },
     "ref": {
      "type": "string",
      "description": "Optional git ref (branch, tag, or commit-ish)",
      "maxLength": 200
     }
    }
   },
   "responseSchema": {
    "type": "object",
    "required": [
     "repository",
     "ref",
     "scannedFiles",
     "checkedUrls",
     "broken",
     "durationMs",
     "requestId",
     "receipt"
    ],
    "properties": {
     "repository": {
      "type": "string"
     },
     "ref": {
      "type": [
       "string",
       "null"
      ]
     },
     "scannedFiles": {
      "type": "integer"
     },
     "checkedUrls": {
      "type": "integer"
     },
     "broken": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "url",
        "status",
        "source",
        "line",
        "error"
       ],
       "properties": {
        "url": {
         "type": "string"
        },
        "status": {
         "type": [
          "integer",
          "null"
         ]
        },
        "source": {
         "type": "string"
        },
        "line": {
         "type": "integer"
        },
        "error": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     },
     "durationMs": {
      "type": "integer"
     },
     "requestId": {
      "type": "string"
     },
     "receipt": {
      "type": "object"
     }
    }
   }
  },
  "health": {
   "method": "GET",
   "path": "/health",
   "responseSchema": {
    "type": "object",
    "required": [
     "status"
    ],
    "properties": {
     "status": {
      "type": "string",
      "const": "ok"
     }
    }
   }
  }
 },
 "pricing": {
  "amountUsd": 1.0,
  "description": "US$1.00 per completed scan",
  "currency": "SOL",
  "referenceQuote": "0.0065",
  "payTo": "CGVHjxwMadDvLB8qGYYyD2TEwB4E8wimg68SUy1vvbzn",
  "billingModel": "manual-invoicing-pilot",
  "pilot": "First external pilot scan is free.",
  "terms": "Payable after result delivery. This version does NOT enforce or automate billing; an operator issues invoices manually. The reference SOL quote is informational; the USD price is the contractual price.",
  "automatic": false
 },
 "limits": {
  "maxRequestBytes": 65536,
  "maxJobSeconds": 240,
  "maxArchiveBytes": 52428800,
  "maxFileBytes": 2097152,
  "maxUrls": 1500,
  "checkConcurrency": 8,
  "checkTimeoutSeconds": 10,
  "maxRedirects": 5
 },
 "supportedFormats": [
  "markdown",
  "mdx",
  "restructuredtext",
  "html"
 ],
 "fileExtensions": [
  ".md",
  ".markdown",
  ".mdx",
  ".rst",
  ".html",
  ".htm"
 ],
 "capabilities": [
  "public-github-repo-scan",
  "markdown-link-extraction",
  "mdx-link-extraction",
  "rst-link-extraction",
  "html-link-extraction",
  "concurrent-head-get-liveness-check",
  "ssrf-protected"
 ]
}